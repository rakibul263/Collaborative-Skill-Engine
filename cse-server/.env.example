MONGODB_URI=your_mongodb_connection_string
PORT=3000

# ── AI Model (choose one) ──────────────────────────────────────────────────────
# Option 1: Groq — FREE, fast. Get key at https://console.groq.com/keys (recommended)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Option 2: Google Gemini — fallback if GROQ_API_KEY is not set
# Free tier available at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash-8b
GEMINI_EMBEDDING_MODEL=text-embedding-004
# ──────────────────────────────────────────────────────────────────────────────

# Firebase Admin (download service account JSON from Firebase Console → Project Settings → Service accounts)
FIREBASE_PROJECT_ID=your_firebase_project_id
# Prefer a file (avoids truncated JSON in .env):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or one-line JSON — must end with closing }
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Admin panel credentials
ADMIN_EMAIL=collaborativeskillengine@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
JWT_SECRET=your_user_jwt_secret_here
CERTIFICATE_SECRET=your_certificate_hmac_secret

# CORS & Frontend URL (Comma-separated, NO trailing slash)
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary (Image / PDF uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=bdt
STRIPE_WEBHOOK_SECRET=

# LiveKit Cloud SFU (Optional — recommended for reliable cross-network WebRTC calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
